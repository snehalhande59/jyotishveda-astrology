# ==============================================================================
# JYOTISHVEDA FRONTEND (NEXT.JS) ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to frontend/.env.local for local development or set in Vercel Project Settings.
# NEVER commit real credentials to Git.
# ==============================================================================

# Backend API Endpoints
# Local: http://localhost:1337 | Production: https://<RENDER_APP>.onrender.com
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
NEXT_PUBLIC_STRAPI_MEDIA_URL=http://localhost:1337

# Frontend Site Domain
# Local: http://localhost:3001 | Production: https://<YOUR_APP>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Razorpay Public Key ID (Safe to expose to browser)
# Test: rzp_test_... | Live: rzp_live_...
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourPublicKeyHere

# Server-Side Only Razorpay Keys (Used in Next.js Server Route Handlers for Shop Checkout)
# NEVER prefix with NEXT_PUBLIC_!
RAZORPAY_KEY_ID=rzp_test_YourPublicKeyHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# Google OAuth Client ID (For client-side Google components if needed)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
