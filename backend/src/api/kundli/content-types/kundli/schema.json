{
  "kind": "collectionType",
  "collectionName": "kundlis",
  "info": {
    "singularName": "kundli",
    "pluralName": "kundlis",
    "displayName": "Kundli Calculation",
    "description": "Calculated Vedic Sidereal Birth Charts"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "fullName": {
      "type": "string",
      "required": true
    },
    "dateOfBirth": {
      "type": "date",
      "required": true
    },
    "timeOfBirth": {
      "type": "string",
      "required": true
    },
    "placeOfBirth": {
      "type": "string",
      "required": true
    },
    "latitude": {
      "type": "decimal",
      "required": true
    },
    "longitude": {
      "type": "decimal",
      "required": true
    },
    "ayanamsa": {
      "type": "string",
      "default": "Lahiri"
    },
    "ascendantSign": {
      "type": "string"
    },
    "moonSign": {
      "type": "string"
    },
    "nakshatra": {
      "type": "string"
    },
    "pada": {
      "type": "integer"
    },
    "chartData": {
      "type": "json"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
