# ==============================================================================
# JYOTISHVEDA STRAPI 5 BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to backend/.env for local development or set in Render Environment Settings.
# NEVER commit real passwords or production secrets to Git.
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=1337
# Set PUBLIC_URL to your Render domain in production (e.g., https://jyotishveda-backend-0epp.onrender.com)
PUBLIC_URL=http://localhost:1337

# Application Security Keys (Generate cryptographically strong keys for production)
APP_KEYS="vedicAppKeySecret1,vedicAppKeySecret2,vedicAppKeySecret3,vedicAppKeySecret4"
API_TOKEN_SALT="apiTokenSaltVedicPlatform2026Key456"
ADMIN_JWT_SECRET="adminSecretVedicPlatform2026SecureKey789"
TRANSFER_TOKEN_SALT="transferTokenSaltVedicPlatform2026Key123"
JWT_SECRET="superJwtSecret1234567890ForVedicAstrologyPlatform"

# Admin Bootstrap (Optional: bootstraps first admin account automatically if empty)
# Strapi admin login uses this on first launch without overriding existing users.
ADMIN_EMAIL=admin@jyotishveda.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Database Configuration (sqlite for local dev, postgres for Render production)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Production PostgreSQL (Render Managed PostgreSQL database credentials)
# DATABASE_CLIENT=postgres
# DATABASE_HOST=dpg-xxxxxxxx.render.com
# DATABASE_PORT=5432
# DATABASE_NAME=vedic_astrology_db
# DATABASE_USERNAME=vedic_user
# DATABASE_PASSWORD=your_render_postgres_password
# DATABASE_SSL=true

# Razorpay Payment Gateway (Test mode: rzp_test_... | Live mode: rzp_live_...)
RAZORPAY_KEY_ID=rzp_test_Sx9dDPssrGbVKO
RAZORPAY_KEY_SECRET=4PEdqkka4in5IWuzKymk7Iyr
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_789

# Frontend URL (Used for CORS and auth redirects. Separate multiple with commas in production)
FRONTEND_URL=http://localhost:3001
DEFAULT_AYANAMSA=Lahiri

# Gmail SMTP Email Notifications (App Password required for 2FA-enabled Gmail)
EMAIL_PROVIDER=nodemailer
EMAIL_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_16_char_app_password
EMAIL_FROM="JyotishVeda <your_email@gmail.com>"
EMAIL_REPLY_TO=your_email@gmail.com

#
# TWILIO
TWILIO_ACCOUNT_SID=your_twilio_account_sid
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Google OAuth 2.0 (Users-Permissions Provider)
# Authorized Redirect URI in Google Cloud Console:
# https://<RENDER_SERVICE_NAME>.onrender.com/api/connect/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:1337/api/connect/google/callback
